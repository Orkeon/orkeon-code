{
  "name": "orkeon-code",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Agentic coding assistant in TypeScript on the Orkeon runtime. Pair with it in the terminal under permission modes, run it fully autonomous in a pipeline, or call its crews from your own application. Every command, crew and prompt is a source file you can change or add to.",
  "license": "MIT",
  "author": "Orkeon Contributors",
  "homepage": "https://github.com/Orkeon/orkeon-code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orkeon/orkeon-code.git"
  },
  "bugs": {
    "url": "https://github.com/Orkeon/orkeon-code/issues"
  },
  "type": "module",
  "files": [
    "orkeon-code",
    "orkeon-code.ps1",
    "src/",
    "!src/**/*.test.ts",
    "config/*.example.json",
    "scripts/setup-fixture.sh",
    "scripts/install.sh",
    "scripts/install.ps1",
    "mcp/whisper/whisper_mcp.py",
    "mcp/whisper/pyproject.toml",
    "mcp/whisper/uv.lock",
    "mcp/whisper/README.md",
    ".orkeon-version",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "bundle:check": "node scripts/bundle-check.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "docs:commands": "node scripts/gen-commands-doc.mjs",
    "check": "npm test && npm run typecheck && npm run bundle:check && npm run check:provenance && node scripts/gen-commands-doc.mjs --check && node scripts/check-docs-parity.mjs",
    "typings": "bash scripts/sync-typings.sh",
    "fixture": "bash scripts/setup-fixture.sh",
    "start": "bash orkeon-code"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
