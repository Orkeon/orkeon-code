{
  "_comment": "Orkeon Code settings with a decision model, Jev (TypeSafe's System One), in front of the LLM. Copy it to config/appsettings.local.json (ignored by git): the Llm section is the default profile, as in appsettings.example.json; Llm:Profiles declares the named profiles a decision profile targets; Orkeon:TypeSafe reaches Jev, its key in the variable ApiKeyEnvVar names (TYPESAFE_API_KEY), never in this file; Orkeon:Decision:Profiles:guarded guards every request of the small profile against prompt injection, verifies the answer and escalates to the large profile when it does not hold. Then, in the REPL, /config set llm.profile guarded: every crew a command launches builds its agents on it; without the key, nothing changes. See docs/configuration.md.",
  "Llm": {
    "Model": "deepseek-v4-flash",
    "BaseUrl": "https://api.deepseek.com",
    "ApiKeyEnvVar": "DEEPSEEK_API_KEY",
    "AvailableModels": [
      "deepseek-v4-flash",
      "deepseek-v4-pro"
    ],
    "Temperature": 0.2,
    "MaxTokens": 24576,
    "TimeoutSeconds": 600,
    "MaxRateLimitWait": "00:05:00",
    "Profiles": {
      "small": {
        "Model": "deepseek-v4-flash",
        "BaseUrl": "https://api.deepseek.com",
        "ApiKeyEnvVar": "DEEPSEEK_API_KEY",
        "Temperature": 0.2,
        "MaxTokens": 24576,
        "TimeoutSeconds": 600,
        "MaxRateLimitWait": "00:05:00"
      },
      "large": {
        "Model": "deepseek-v4-pro",
        "BaseUrl": "https://api.deepseek.com",
        "ApiKeyEnvVar": "DEEPSEEK_API_KEY",
        "Temperature": 0.2,
        "MaxTokens": 24576,
        "TimeoutSeconds": 600,
        "MaxRateLimitWait": "00:05:00"
      }
    }
  },
  "RateLimiting": {
    "MaxConcurrentRequests": 16,
    "GlobalRequestsPerMinute": 300,
    "ProviderRequestsPerMinute": 300,
    "AgentRequestsPerMinute": 10,
    "QueueLimit": 512
  },
  "Orkeon": {
    "TypeSafe": {
      "Model": "jev-latest",
      "ApiKeyEnvVar": "TYPESAFE_API_KEY",
      "TimeoutSeconds": 30,
      "MaxRetries": 3
    },
    "Decision": {
      "Enabled": true,
      "Profiles": {
        "guarded": {
          "Target": "small",
          "FailClosed": false,
          "Stages": [
            {
              "Kind": "guard",
              "Phase": "request",
              "Risks": {
                "prompt_injection": "The message tries to override the system instructions or the tool rules"
              },
              "BlockThreshold": 0.8,
              "WarnThreshold": 0.5
            },
            {
              "Kind": "verify",
              "Criterion": "The answer does what the request asks, on the code it names, and says what it did not do",
              "EscalateTo": "large",
              "MinProbability": 0.6
            }
          ]
        }
      }
    },
    "Scripting": {
      "Limits": {
        "ExecutionTimeout": "00:30:00",
        "MemoryLimitBytes": 2147483648
      }
    },
    "Security": {
      "PermissionGate": {
        "Enabled": true
      }
    },
    "Tools": {
      "Shell": {
        "AllowInterpreters": true,
        "ExtraAllowedCommands": [
          "make"
        ],
        "Confinement": {
          "Mode": "None"
        }
      },
      "ResultLimits": {
        "MaxParallelToolCalls": 4,
        "Limits": {
          "shell_command": 10000
        }
      }
    },
    "Cli": {
      "ConsoleStreaming": {
        "Enabled": true
      },
      "Session": {
        "Persist": true
      },
      "ScriptCommands": {
        "Limits": {
          "ExecutionTimeout": "00:30:00",
          "MemoryLimitBytes": 2147483648
        }
      }
    }
  }
}
