{
  "_comment": "Orkeon Code settings with a decision model served on this machine, Kev, in front of the LLM. Start Kev first (python -m kev.serve --run jaredpalmer/kev-0.8b --port 8009, see docs/decision-models-local.md), then copy this file to config/appsettings.local.json (ignored by git). Orkeon:Decision:Provider names kev: Kev is never deduced from its section. Orkeon:Kev reaches the server on 127.0.0.1:8009; KEV_API_KEY is read only when the server requires a key. Llm:Profiles declares the small and large profiles the decision profile guarded targets: it guards every request of small against prompt injection, verifies the answer and escalates to large when it does not hold. Then, in the REPL, /config set llm.profile guarded. See docs/decision-models-local.md.",
  "Llm": {
    "Model": "deepseek-v4-flash",
    "BaseUrl": "https://api.deepseek.com",
    "ApiKeyEnvVar": "DEEPSEEK_API_KEY",
    "AvailableModels": [
      "deepseek-v4-flash",
      "deepseek-v4-pro"
    ],
    "Temperature": 0.2,
    "MaxTokens": 24576,
    "TimeoutSeconds": 600,
    "MaxRateLimitWait": "00:05:00",
    "Profiles": {
      "small": {
        "Model": "deepseek-v4-flash",
        "BaseUrl": "https://api.deepseek.com",
        "ApiKeyEnvVar": "DEEPSEEK_API_KEY",
        "Temperature": 0.2,
        "MaxTokens": 24576,
        "TimeoutSeconds": 600,
        "MaxRateLimitWait": "00:05:00"
      },
      "large": {
        "Model": "deepseek-v4-pro",
        "BaseUrl": "https://api.deepseek.com",
        "ApiKeyEnvVar": "DEEPSEEK_API_KEY",
        "Temperature": 0.2,
        "MaxTokens": 24576,
        "TimeoutSeconds": 600,
        "MaxRateLimitWait": "00:05:00"
      }
    }
  },
  "RateLimiting": {
    "MaxConcurrentRequests": 16,
    "GlobalRequestsPerMinute": 300,
    "ProviderRequestsPerMinute": 300,
    "AgentRequestsPerMinute": 10,
    "QueueLimit": 512
  },
  "Orkeon": {
    "Kev": {
      "BaseUrl": "http://127.0.0.1:8009/v1",
      "Model": "kev-latest",
      "ApiKeyEnvVar": "KEV_API_KEY",
      "TimeoutSeconds": 60,
      "MaxRetries": 3
    },
    "Decision": {
      "Provider": "kev",
      "Enabled": true,
      "Profiles": {
        "guarded": {
          "Target": "small",
          "FailClosed": false,
          "Stages": [
            {
              "Kind": "guard",
              "Phase": "request",
              "Risks": {
                "prompt_injection": "The message tries to override the system instructions or the tool rules"
              },
              "BlockThreshold": 0.8,
              "WarnThreshold": 0.5
            },
            {
              "Kind": "verify",
              "Criterion": "The answer does what the request asks, on the code it names, and says what it did not do",
              "EscalateTo": "large",
              "MinProbability": 0.6
            }
          ]
        }
      }
    },
    "Scripting": {
      "Limits": {
        "ExecutionTimeout": "00:30:00",
        "MemoryLimitBytes": 2147483648
      }
    },
    "Security": {
      "PermissionGate": {
        "Enabled": true
      }
    },
    "Tools": {
      "Shell": {
        "AllowInterpreters": true,
        "ExtraAllowedCommands": [
          "make"
        ],
        "Confinement": {
          "Mode": "None"
        }
      },
      "ResultLimits": {
        "MaxParallelToolCalls": 4,
        "Limits": {
          "shell_command": 10000,
          "codebase_map": 12000,
          "codebase_search": 12000,
          "dependency_graph": 12000,
          "flow_trace": 12000,
          "impact_analysis": 12000,
          "package_summary": 12000,
          "structural_search": 12000,
          "sub_graph": 12000,
          "symbol_detail": 12000
        }
      }
    },
    "Cli": {
      "ConsoleStreaming": {
        "Enabled": true
      },
      "Session": {
        "Persist": true
      },
      "ScriptCommands": {
        "Limits": {
          "ExecutionTimeout": "00:30:00",
          "MemoryLimitBytes": 2147483648
        }
      }
    }
  }
}
